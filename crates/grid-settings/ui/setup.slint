import { Button, CheckBox, HorizontalBox, Palette } from "std-widgets.slint";
import { Card, Divider, Glass, GlassBackdrop } from "theme.slint";

/// One way to set up Grid: a button and what it does.
component Choice inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <bool> recommended;
    callback chosen();
    spacing: 14px;
    Button {
        text: root.label;
        primary: root.recommended;
        width: 220px;
        clicked => { root.chosen(); }
    }
    Text {
        text: root.detail;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

/// Asked before uninstalling (from Windows Settings → Apps, or Grid's settings window).
export component UninstallWindow inherits Window {
    // Same as UNINSTALL_TITLE in grid-windows.
    title: "Uninstall Grid";
    width: 460px;
    always-on-top: true;
    default-font-family: "Plus Jakarta Sans";
    /// The desktop shows through, blurred, once the system's backdrop is in place (set by the
    /// app). Until then, or where there is none, the window is opaque.
    in property <bool> glass;
    background: root.glass ? transparent : Palette.background;
    /// "Light", "Dark" or "System".
    in-out property <string> appearance: "System";
    /// Whether the system is in dark mode; used when Appearance is "System".
    in property <bool> system-dark;
    /// Whether the window is dark right now; `dark-changed` reports changes.
    out property <bool> dark: Glass.dark;
    callback dark-changed(bool);
    in property <image> logo;
    in-out property <bool> delete-settings;
    callback answered(bool);

    GlassBackdrop {
        glass: root.glass;
        appearance: root.appearance;
        system-dark: root.system-dark;
        dark-changed(dark) => { root.dark-changed(dark); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Image { source: root.logo; width: 32px; height: 32px; }
            Text {
                text: "Remove Grid from this PC?";
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        CheckBox {
            text: "Also delete my settings and saved window positions";
            checked <=> root.delete-settings;
        }
        HorizontalBox {
            padding: 0;
            padding-top: 4px;
            alignment: end;
            Button {
                text: "Cancel";
                clicked => { root.answered(false); }
            }
            Button {
                text: "Uninstall";
                primary: true;
                clicked => { root.answered(true); }
            }
        }
    }
}

/// Shown the first time a downloaded grid.exe runs (and from Settings, "Install Grid").
export component SetupWindow inherits Window {
    // Same as SETUP_TITLE in grid-windows.
    title: "Grid Setup";
    width: 580px;
    always-on-top: true;
    default-font-family: "Plus Jakarta Sans";
    /// The desktop shows through, blurred, once the system's backdrop is in place (set by the
    /// app). Until then, or where there is none, the window is opaque.
    in property <bool> glass;
    background: root.glass ? transparent : Palette.background;
    /// "Light", "Dark" or "System".
    in-out property <string> appearance: "System";
    /// Whether the system is in dark mode; used when Appearance is "System".
    in property <bool> system-dark;
    /// Whether the window is dark right now; `dark-changed` reports changes.
    out property <bool> dark: Glass.dark;
    callback dark-changed(bool);
    in property <image> logo;
    /// Non-empty when Grid is already installed on this PC: says so above the choices.
    in property <string> existing;
    in-out property <bool> autostart: true;
    /// Start-with-Windows sub-options (used when installing for all users).
    in-out property <bool> autostart-all-users;
    in-out property <bool> autostart-admin;
    in-out property <bool> autostart-all-admins;
    /// Whether the user's account is an administrator: the administrator options are shown.
    in property <bool> user-is-admin;
    /// "all", "user" or "portable".
    callback chosen(string);
    callback canceled();

    GlassBackdrop {
        glass: root.glass;
        appearance: root.appearance;
        system-dark: root.system-dark;
        dark-changed(dark) => { root.dark-changed(dark); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 14px;
            Image { source: root.logo; width: 48px; height: 48px; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "Welcome to Grid"; font-size: 22px; font-weight: 700; }
                Text { text: "Install Grid on this PC, or run it from this folder."; opacity: 0.8; }
            }
        }
        if root.existing != "": Text {
            text: root.existing;
            wrap: word-wrap;
            // Fixed, so the window is sized for the wrapped text (see admin.slint).
            width: 540px;
        }
        Card {
            Choice {
                label: "Install for all users";
                detail: "Recommended, for the best compatibility. Windows will ask for administrator rights.";
                recommended: true;
                chosen => { root.chosen("all"); }
            }
            Divider { }
            Choice {
                label: "Install just for me";
                detail: "No administrator rights needed.";
                chosen => { root.chosen("user"); }
            }
            Divider { }
            Choice {
                label: "Run without installing";
                detail: "Portable: Grid and its settings stay in this folder. It won't start with Windows.";
                chosen => { root.chosen("portable"); }
            }
        }
        Card {
            CheckBox {
                text: "Start Grid when Windows starts";
                checked <=> root.autostart;
            }
            // Same sub-options as Settings → General (see grid-core's `startup`).
            VerticalLayout {
                padding-left: 28px;
                spacing: 4px;
                CheckBox {
                    text: "For all users on this PC";
                    checked <=> root.autostart-all-users;
                }
                if root.user-is-admin: CheckBox {
                    text: "As administrator";
                    enabled: root.autostart || root.autostart-all-admins;
                    checked <=> root.autostart-admin;
                    toggled => {
                        if !self.checked {
                            root.autostart-all-admins = false;
                        }
                    }
                }
                if root.user-is-admin: HorizontalLayout {
                    padding-left: 28px;
                    CheckBox {
                        text: "For all administrators on this PC";
                        enabled: root.autostart-admin;
                        checked <=> root.autostart-all-admins;
                    }
                }
            }
            Text {
                text: root.user-is-admin
                    ? "Only when installed: Grid can't start with Windows when run without installing. The options under it are for \"Install for all users\" only. As administrator, Grid can move windows of apps run as administrator (e.g. Task Manager) without asking."
                    : "Only when installed: Grid can't start with Windows when run without installing. \"For all users\" is for \"Install for all users\" only.";
                wrap: word-wrap;
                width: 510px;
                font-size: 12px;
                opacity: 0.7;
            }
        }
        HorizontalBox {
            padding: 0;
            alignment: end;
            Button {
                text: "Cancel";
                clicked => { root.canceled(); }
            }
        }
    }
}
